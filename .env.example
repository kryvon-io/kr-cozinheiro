# Conexão com o Postgres da Neon (Dashboard Neon > Connect > "Pooled connection")
DATABASE_URL="postgresql://USUARIO:SENHA@HOST-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require"

# E-mail usado para entrar no app
AUTH_EMAIL="voce@exemplo.com"

# Hash da senha (gere com: npm run hash-password -- "sua-senha")
AUTH_PASSWORD_HASH="salt_hex:hash_hex"

# Segredo para assinar a sessão (gere com: openssl rand -base64 32)
AUTH_SECRET="troque-por-um-valor-aleatorio-com-32-caracteres-ou-mais"
